diff --git a/src/floating/waitingScan.test.ts b/src/floating/waitingScan.test.ts
new file mode 100644
index 00000000..efb471b9
--- /dev/null
+++ b/src/floating/waitingScan.test.ts
@@ -0,0 +1,30 @@
+import { describe, expect, it } from "vitest";
+import { liveTerminals, waitingTabs, type Call } from "./waitingScan";
+
+const prompt = { kind: "approval", text: "Allow?", options: [] };
+
+describe("floating panel waiting scan (after-list row 141)", () => {
+  it("lists the tabs whose screen shows an open prompt and asks Rust per terminal", async () => {
+    const asked: unknown[] = [];
+    const call: Call = async (cmd, args) => (asked.push([cmd, args]), (args.terminal as number) === 7 ? { prompt, changed: true } : { prompt: null, changed: false });
+    expect(await waitingTabs(call, { 1000001: 7, 1000002: 8 })).toEqual([1000001]);
+    expect(asked).toEqual([
+      ["prompt_scan", { paneKey: 1000001, terminal: 7 }],
+      ["prompt_scan", { paneKey: 1000002, terminal: 8 }],
+    ]);
+  });
+
+  it("counts nothing when no tab waits, when a scan fails, or when there is no terminal", async () => {
+    const call: Call = async (_c, args) => {
+      if (args.terminal === 9) throw new Error("gone");
+      return { prompt: null, changed: false };
+    };
+    expect(await waitingTabs(call, { 1000001: 8, 1000002: 9 })).toEqual([]);
+    expect(await waitingTabs(call, {})).toEqual([]);
+  });
+
+  it("leaves out the tab whose program ended", () => {
+    const tabs = [{ key: 1000001 }, { key: 1000002, exited: true }, { key: 1000003 }];
+    expect(liveTerminals({ 1000001: 7, 1000002: 8 }, tabs)).toEqual({ 1000001: 7 });
+  });
+});
diff --git a/src/floating/waitingScan.ts b/src/floating/waitingScan.ts
new file mode 100644
index 00000000..07530b4e
--- /dev/null
+++ b/src/floating/waitingScan.ts
@@ -0,0 +1,24 @@
+// after-list row 141 (TERM-063): which floating-panel tabs sit at an open prompt, read off each
+// terminal's screen with the same Rust scan the window's panes use (prompt_scan). The panel's tabs
+// have no pane key the hooks know, so the screen is the only place their wait can be seen.
+export const SCAN_EVERY_MS = 1500;
+
+export type Call = (cmd: string, args: Record<string, unknown>) => Promise<unknown>;
+
+/** The tab keys whose terminal shows an open prompt; a tab with no terminal yet, or a scan that fails, counts as not waiting. */
+export async function waitingTabs(call: Call, ptys: Record<number, number>): Promise<number[]> {
+  const waiting: number[] = [];
+  for (const [k, terminal] of Object.entries(ptys)) {
+    if (!Number.isInteger(terminal)) continue;
+    const scan = (await call("prompt_scan", { paneKey: Number(k), terminal }).catch(() => null)) as { prompt?: unknown } | null;
+    if (scan?.prompt) waiting.push(Number(k));
+  }
+  return waiting;
+}
+
+/** The terminals of tabs that are still running a program; a tab whose program ended can no longer wait. */
+export function liveTerminals(ptys: Record<number, number>, tabs: { key: number; exited?: boolean }[]): Record<number, number> {
+  const out: Record<number, number> = {};
+  for (const t of tabs) if (!t.exited && t.key in ptys) out[t.key] = ptys[t.key];
+  return out;
+}
