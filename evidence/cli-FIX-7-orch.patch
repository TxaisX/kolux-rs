-pub fn worker_terminal(fresh: &[(u32, Option<String>)], agent: &str) -> Option<u32> {
-    let mut mine = fresh.iter().filter(|(_, a)| a.as_deref() == Some(agent)).map(|(id, _)| *id);
-    match (mine.next(), mine.next()) {
-        (Some(id), None) => Some(id),
-        _ => None,
-    }
-}
