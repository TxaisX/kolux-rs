+/// Row 371: only a HOME that is itself scratch may sit under TEMP; the user's real home never passes.
+#[test]
+fn row371_a_home_under_temp_passes_only_when_it_is_marked_scratch() {
+    let root = temp("row371-home");
+    let (cfg, home, real) = (root.join("tmp").join("cfg"), root.join("home"), root.join("Users").join("someone"));
+    for d in [&cfg, &home, &real] {
+        fs::create_dir_all(d).unwrap();
+    }
+    fs::write(cfg.join(SCRATCH_MARKER), "").unwrap();
+    let file = cfg.join("settings.json");
+    // Unmarked home under TEMP (the real home, or USERPROFILE): refused.
+    for h in [&home, &real, &root.join("Users")] {
+        let err = scratch_only(&file, &root, h).unwrap_err();
+        assert!(err.contains("holds the home folder") && err.contains("left alone"), "{err}");
+    }
+    // A marker in TEMP itself marks no home.
+    fs::write(root.join(SCRATCH_MARKER), "").unwrap();
+    assert!(scratch_only(&file, &root, &home).unwrap_err().contains("holds the home folder"));
+    assert!(scratch_only(&file, &root, &root).unwrap_err().contains("holds the home folder"));
+    // A marked scratch home, or one below a marked folder, is admitted.
+    fs::write(home.join(SCRATCH_MARKER), "").unwrap();
+    assert!(scratch_only(&file, &root, &home).is_ok());
+    assert!(scratch_only(&file, &root, &home.join("AppData")).is_err(), "a home that does not exist cannot be resolved");
+    fs::create_dir_all(home.join("AppData")).unwrap();
+    assert!(scratch_only(&file, &root, &home.join("AppData")).is_ok());
+    // The marker on home never admits a file that is not itself scratch.
+    assert!(scratch_only(&real.join("settings.json"), &root, &home).is_err());
+    // The unmarked real home is still refused after all that.
+    assert!(scratch_only(&file, &root, &real).is_err());
     let _ = fs::remove_dir_all(&root);
 }
 
