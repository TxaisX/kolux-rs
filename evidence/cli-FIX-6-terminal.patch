+    let dispatch = env_own.iter().find(|(k, _)| k == crate::cli::DISPATCH_ENV).map(|(_, v)| v.clone());
     let id = terminals.spawn(app.clone(), cols, rows, cwd, program, args, env_own, env, pane_key, shell)?;
